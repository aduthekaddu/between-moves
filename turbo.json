{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "env": ["NODE_EXTRA_CA_CERTS", "TEST_DATABASE_URL"]
    },
    "test:e2e": {
      "cache": false,
      "env": [
        "DATABASE_URL",
        "NODE_EXTRA_CA_CERTS",
        "PLAYWRIGHT_BROWSERS_PATH",
        "TEST_DATABASE_URL"
      ]
    }
  }
}
