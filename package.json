{
  "name": "between-moves",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "pnpm lint:boundaries && turbo run lint",
    "lint:boundaries": "eslint apps/worker/src packages/domain/src packages/application/src packages/db/src packages/adapters/src packages/observability/src --max-warnings=0",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:boundaries && pnpm test:isolation-coverage && pnpm test:pilot-ops && turbo run test --concurrency=1",
    "test:coverage": "pnpm test:boundaries && pnpm test:isolation-coverage && node --experimental-test-coverage --test scripts/pilot-ops.test.mjs && turbo run test --concurrency=1 -- --coverage",
    "test:boundaries": "node --test tooling/import-boundaries.test.mjs",
    "test:isolation-coverage": "node --test tooling/house-write-isolation-coverage.test.mjs",
    "test:pilot-ops": "node --test scripts/pilot-ops.test.mjs",
    "pilot:metrics": "psql -X -v ON_ERROR_STOP=1 -f ops/product-metrics.sql",
    "pilot:dashboard": "node scripts/pilot-dashboard.mjs",
    "pilot:alerts": "node scripts/pilot-alerts.mjs",
    "pilot:restore-drill": "node scripts/restore-drill.mjs",
    "traceability:generate": "node tooling/traceability.mjs --write",
    "traceability:check": "node --test tooling/traceability.test.mjs && node tooling/traceability.mjs --check",
    "test:e2e": "turbo run test:e2e",
    "formal:check": "node tooling/formal-check.mjs",
    "formal:selftest": "node --test tooling/formal-check.test.mjs",
    "db:migrate": "pnpm --filter @between-moves/db migrate",
    "db:migrate:down": "pnpm --filter @between-moves/db migrate:down",
    "db:generate": "pnpm --filter @between-moves/db schema:generate",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@typescript-eslint/parser": "8.68.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "turbo": "2.10.12"
  }
}
