{
  "name": "@between-moves/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./database": "./src/database.ts",
    "./testing": "./src/testing/index.ts",
    "./test-database": "./src/test-database/index.ts",
    "./test-database/vitest": "./src/test-database/vitest.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "migrate": "tsx src/migrate-cli.ts up",
    "migrate:down": "tsx src/migrate-cli.ts down",
    "schema:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@between-moves/domain": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
