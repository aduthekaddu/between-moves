# Copy these values into the matching Trigger.dev environment in its dashboard.
# Set TRIGGER_PROJECT_ID in the shell that runs trigger:dev or trigger:deploy.
TRIGGER_PROJECT_ID=proj_replace_with_project_reference
DATABASE_URL=postgresql://replace-with-neon-url?sslmode=require
APP_ORIGIN=https://between-moves-web.vercel.app
BETTER_AUTH_SECRET=replace-with-the-same-value-as-vercel
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL=Between Moves <hello@your-verified-domain.example>
REALTIME_SERVER_KEY=replace-with-the-same-value-as-vercel

# Keep analysis disabled until an engine service exists.
ANALYSIS_ENABLED=false
# ANALYSIS_WORKER_URL=https://replace-with-analysis-engine-url
# ANALYSIS_WORKER_SECRET=replace-with-shared-analysis-secret
