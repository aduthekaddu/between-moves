# Required server configuration (replace every placeholder; never commit real values)
DATABASE_URL=postgresql://app:local-only@localhost:5432/between_moves?sslmode=require
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:3000
RESEND_API_KEY=replace-with-resend-sandbox-key
RESEND_WEBHOOK_SECRET=replace-with-resend-webhook-secret
REALTIME_APP_ID=replace-with-realtime-sandbox-app-id
REALTIME_SERVER_KEY=replace-with-realtime-server-key
REALTIME_PUBLIC_KEY=replace-with-realtime-public-key
ANALYSIS_WORKER_URL=http://localhost:3100
ANALYSIS_WORKER_SECRET=replace-with-analysis-worker-secret
UPSTASH_REDIS_REST_URL=https://replace-with-upstash-rest-url
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token

# Optional deployment metadata (Vercel metadata is detected automatically)
APP_ENV=local
BUILD_ID=local
